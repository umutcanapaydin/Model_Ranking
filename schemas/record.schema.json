{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$comment": "GENERATED from scripts/check_records.py constants -- do not hand-edit (GPF-002: the hand-written version said 7 record types while the validator enforced 14, and nothing read it. This file now has a reader: conformance/test-schema-sync.py fails on drift). Regenerate: python3 scripts/gen_schema.py",
  "title": "GP governance record frontmatter",
  "type": "object",
  "required": [
    "record_type",
    "id",
    "status"
  ],
  "properties": {
    "record_type": {
      "enum": [
        "adr",
        "brief",
        "closure",
        "council",
        "design",
        "experience",
        "field-findings",
        "fixpack",
        "handover",
        "harvest",
        "license-review",
        "plan",
        "ratification",
        "register",
        "retrospective",
        "review",
        "status",
        "warnings",
        "wave"
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.\\-]{2,63}$"
    },
    "status": {
      "enum": [
        "draft",
        "candidate",
        "ratified",
        "superseded",
        "retired"
      ]
    },
    "process_version_harvested": {},
    "process_version_target": {},
    "project": {},
    "harvest_context_sha256": {},
    "harvester_conflict": {},
    "companion": {},
    "parent": {},
    "seat": {},
    "process_version": {},
    "supersedes": {},
    "requires": {},
    "subject_ref": {},
    "propagation": {},
    "evidence_ref": {},
    "approvers": {},
    "date": {}
  },
  "additionalProperties": false
}
