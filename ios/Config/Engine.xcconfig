// M18-W1 (D-171): the engine the app talks to, read into the Info plist's `EngineURL`.
// The hosted engine is the only engine (D-222). Loopback serves the simulator, against `make run` on the
// developer's machine; a phone asks the hosted engine (#288). A git-ignored Engine.local.xcconfig beside
// this file may set a Debug-only address of its own:
//   ENGINE_URL[config=Debug] = http:/$()/127.0.0.1:8090   (Debug only: Release stays hosted)
// (`/$()/` keeps `//` from starting a comment in an xcconfig.)
ENGINE_URL = http:/$()/127.0.0.1:8080
// #288 (D-202 clause 4): a build for a phone says so, and the app then asks the hosted engine instead of
// loopback, which a phone can never reach. An address of your own above, in Engine.local.xcconfig, is
// still asked. The simulator shares the Mac's loopback and keeps it.
ENGINE_ON_DEVICE = NO
ENGINE_ON_DEVICE[sdk=iphoneos*] = YES
// The app icon (M19-W5): App Store Connect refuses an upload without one.
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
// The bundle id lives here, not in the project, so a personal team can override it (and set
// DEVELOPMENT_TEAM) in Engine.local.xcconfig without touching a tracked file.
PRODUCT_BUNDLE_IDENTIFIER = com.ilgar.modelranking
#include? "Engine.local.xcconfig"
// M19-W5: a Release build (an archive for TestFlight) reaches the hosted engine, over HTTPS, at the
// name the deployment answers to (fly.toml's `app`, #94). After the local file, on purpose: the last
// matching setting wins, so no local ENGINE_URL can send an archive elsewhere (the M19 security
// review's S1).
ENGINE_URL[config=Release] = https:/$()/model-ranking.fly.dev
