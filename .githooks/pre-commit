#!/usr/bin/env bash
# pre-commit -- the owner's ruling of 2026-10-10 on `commit-after-check-fast` ("fix and narrow").
# Install once per clone: `make hooks`.
#
# A commit that changes anything but docs runs `make check-fast`; a docs-only commit (every staged path a
# Markdown file outside the code directories, `scripts/commit_gate.py`) runs `make check-records`. The
# commit is refused when its gate fails.
#
# BYPASS. A human may commit with `git commit --no-verify` when that is right, and adds the row to
# `docs/control-events.csv`; an agent never does.
#
# Exit: 0 the gate passed · non-zero commit refused.
set -uo pipefail
cd "$(git rev-parse --show-toplevel)" || exit 1
py="$(command -v python3 || command -v python)" || { echo "pre-commit REFUSED the commit: no python3 or python on PATH (see INSTALL.md)" >&2; exit 1; }
# Read the index git is committing (GIT_INDEX_FILE may name a temporary one) before the environment is cleared.
target="$("$py" -B scripts/commit_gate.py)" || { echo "pre-commit REFUSED the commit: scripts/commit_gate.py could not read the staged paths" >&2; exit 1; }
# Git exports GIT_DIR and GIT_INDEX_FILE to hooks; the gate's controls run git in throwaway repositories.
unset $(git rev-parse --local-env-vars)

echo "pre-commit: running make $target"
if make "$target"; then
  exit 0
fi
echo "pre-commit REFUSED the commit: make $target failed above. Fix it; a human may bypass with --no-verify and must add the row to docs/control-events.csv." >&2
exit 1
