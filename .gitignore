.env
.env.local
.env.*.local
*.pem
*.key

# Build artifacts
dist/
build/
*.egg

# Pipeline v2.0 — local-only harness config
.claude/settings.local.json
.claude/last-check.log

# Pipeline v2.0 — per-developer rules (.agents/rules/environment.md is gitignored)
.agents/rules/environment.md

# Local override docs (per-developer)
*.local.md
notes/

# data artifacts (security review M1 MINOR-2)
*.db
*.sqlite3
ios/.build/
coverage.json
advisor.db.refresh.json
advisor.db.refresh.lock
*.candidate
*.building
# a refresh cycle's other scratch (M16-W4 security pass F2): build reports, arrival records, and
# the unpacked Epoch bundle, which carries third-party data (W-129) and must never be committed
*.sources
*.last-ok
*.epoch/

# DevFlow v6.0: the JUnit report `pytest` writes for the CI skip budget (scripts/coverage_floor.py)
.pytest-report.xml

# DevFlow v6.0 install marker. `make install` rewrites it on every target (its commit field moves
# with HEAD), so tracking it dirtied the tree after every `make check` (adoption review MINOR-3, D-155).
.gp/
